# ── Twitch Credentials ──────────────────────────────────────────────────────
# The username of your bot's Twitch account (lowercase)
BOT_USERNAME=your_bot_username

# The name of the channel the bot should join (your main account, lowercase)
CHANNEL_NAME=your_channel_name

# From twitchtokengenerator.com (logged in as the BOT account)
TWITCH_CLIENT_ID=your_client_id
TWITCH_ACCESS_TOKEN=your_access_token
TWITCH_REFRESH_TOKEN=your_refresh_token
TWITCH_CLIENT_SECRET=your_client_secret

# ── Bot Settings ─────────────────────────────────────────────────────────────
# Prefix used for all commands (e.g. ! means !roulette, !help, etc.)
COMMAND_PREFIX=!

# ── Logging ──────────────────────────────────────────────────────────────────
# "development" → pretty colored logs
# "production"  → JSON logs (better for log aggregators)
NODE_ENV=development
